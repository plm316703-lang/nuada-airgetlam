# ==========================================================
# .env.example — 환경 변수 "견본"
# 사용법: 이 파일을 복사해 이름을 .env 로 바꾸고, 값을 내 값으로 채운다.
#        .env 는 .gitignore 대상이라 GitHub에 올라가지 않는다. (이 견본 파일만 커밋)
# 로컬 실행(Spring·Python)과 Docker 실행이 모두 이 .env 하나를 읽는다.
# 여기 적힌 값은 전부 가짜 예시다. 실제 비밀번호를 이 파일에 쓰지 않는다.
# ==========================================================

# --- MySQL (로컬: 내 PC MySQL에 이 DB·계정을 만든다 / Docker: 컨테이너가 자동으로 만든다) ---
MYSQL_DATABASE=nuada
MYSQL_USER=nuada
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Python 재생기 → Spring 관문 공유 비밀키 ---
GATEWAY_API_KEY=change-me-gateway-key

# --- 로그인 토큰(JWT) 서명 비밀키: 영문·숫자 32자 이상 ---
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# --- 시연 계정(@nuada.test) 비밀번호. 비워 두면 시연 계정을 만들지 않음 ---
DEMO_PASSWORD=change-me-demo-password

# --- RAG (Gemini). https://aistudio.google.com 에서 발급 ---
GEMINI_API_KEY=
# 모델 이름을 바꿔야 할 때만 주석을 풀어 사용
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# 무작위 값 만들기 (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
