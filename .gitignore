# ==========================================================
# .gitignore — GitHub에 "올리지 않을" 파일 목록
# 규칙: 자동으로 다시 만들어지는 파일, 내 컴퓨터 전용 설정, 비밀 정보는 올리지 않는다
# ==========================================================

# ---------- 1. 비밀 정보 (가장 중요!) ----------
# LLM API 키, DB 비밀번호 등이 들어가는 파일
# 실수로 올리면 남이 내 API 키로 결제할 수 있으니 반드시 제외
.env
*.env
application-secret.yml
application-local.yml

# ---------- 2. Java / Spring 빌드 결과물 ----------
# 빌드하면 다시 생기는 파일들이라 올릴 필요가 없음
build/
out/
target/
.gradle/
!gradle/wrapper/gradle-wrapper.jar
*.class
*.log

# ---------- 3. IntelliJ 등 개발도구 설정 ----------
# 각자 컴퓨터마다 다른 설정이라 공유하지 않음
.idea/
*.iml
*.iws
.vscode/

# ---------- 4. Python ----------
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# ---------- 5. 데이터 파일 ----------
# 뇌파 데이터셋은 용량이 커서 GitHub에 올리지 않고, README에 다운로드 방법을 적음
data/
*.gdf
*.edf
*.fif

# ---------- 6. 운영체제가 만드는 파일 ----------
.DS_Store
Thumbs.db
